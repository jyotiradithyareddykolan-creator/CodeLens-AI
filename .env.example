# ==========================================
# CodeLens AI - Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
# Log SQL statements (including bound parameters). Keep False outside local debugging.
DATABASE_ECHO=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the API refuses to start with a placeholder or short SECRET_KEY,
# with DEBUG/DATABASE_ECHO enabled, or without GITHUB_WEBHOOK_SECRET.
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-min
# Public URLs. BACKEND_URL must be reachable by the browser (OAuth callback).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codelens_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codelens_ai
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codelens_ai

# Redis & Celery Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Intelligence & Embeddings (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_LLM_MODEL=gemini-1.5-flash

# GitHub App Integration (see README "GitHub App setup")
GITHUB_APP_ID=
# The App's public slug, from https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# Client ID/secret of the GitHub App itself (not a separate OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
# Alternatively, inline PEM private key:
GITHUB_PRIVATE_KEY=

# GitHub API client (optional; defaults shown)
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=4
# Longest single wait for a rate-limit reset before the request fails
GITHUB_MAX_RETRY_WAIT_SECONDS=120

# Repository discovery limits (optional; defaults shown)
INDEX_MAX_CANDIDATE_FILES=50000
INDEX_MAX_TREE_REQUESTS=2000

# Vector & Codebase Indexing Settings
MAX_FILE_SIZE_BYTES=1048576  # 1MB
# Max estimated tokens per chunk incl. its context header (64-2048)
CHUNK_MAX_TOKENS=500
# Calibration factor for the token estimator (1.0 until measured against Gemini)
CHUNK_TOKEN_ESTIMATE_MULTIPLIER=1.0
CHUNK_OVERLAP_TOKENS=50
