# ==========================================
# CodeLens AI - Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-min
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codelens_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codelens_ai
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codelens_ai

# Redis & Celery Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Intelligence & Embeddings (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_LLM_MODEL=gemini-1.5-flash

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
# Alternatively, inline PEM private key:
GITHUB_PRIVATE_KEY=

# Vector & Codebase Indexing Settings
MAX_FILE_SIZE_BYTES=1048576  # 1MB
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
